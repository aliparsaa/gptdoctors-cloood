import type { MetadataRoute } from 'next'

const SITE_URL = 'https://gptdoctors.ir'

export default function sitemap(): MetadataRoute.Sitemap {
  const routes = [
    '/',
    '/ai-audit',
    '/features',
    '/how-it-works',
    '/pricing',
    '/docs',
    '/contact',
    '/privacy',
    '/terms',
  ]

  return routes.map((route) => ({
    url: `${SITE_URL}${route}`,
    lastModified: new Date(),
    changeFrequency: route === '/privacy' || route === '/terms' ? 'yearly' : 'weekly',
    priority: route === '/' ? 1 : 0.8,
  }))
}
